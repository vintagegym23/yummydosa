{
  "name": "yummy-dosa-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/image-variants.mjs && node scripts/prerender.mjs",
    "preview": "vite preview --port=4173",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "test": "npm run lint && npm run check:assets",
    "serve:prod": "node scripts/serve-prod.mjs",
    "test:e2e": "node scripts/smoke-test.mjs",
    "test:seo": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/epilogue": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.4"
  }
}
